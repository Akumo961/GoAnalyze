              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/documents/{document_id}/process": {
      "post": {
        "summary": "Process Document",
        "description": "Run the native ingestion pipeline: OCR, classification, metadata and\nentity extraction, compliance analysis, risk scoring, vector indexing,\nworkflow routing, and audit logging.",
        "operationId": "process_document_v1_documents__document_id__process_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Document Id"
            }
