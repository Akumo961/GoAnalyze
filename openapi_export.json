        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/setup": {
      "post": {
        "summary": "Submit Setup Configuration",
        "description": "Accept configuration collected by the enterprise configuration wizard\n(PostgreSQL, MinIO, OpenSearch, Redis, Keycloak/Azure AD/Microsoft Entra ID,\nOCR engine, AI provider, object storage, email notifications). Real\ndeployments persist this to a secrets manager; here it is validated and\nechoed back as accepted components so operators know what is wired up.",
        "operationId": "submit_setup_configuration_v1_setup_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupConfiguration"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupConfigurationResult"
