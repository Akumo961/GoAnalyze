                }
              }
            }
          }
        }
      }
    },
    "/v1/rag/answer": {
      "post": {
        "summary": "Rag Answer",
        "description": "Answer a question grounded in the supplied evidence citations.\n\nEvery cited document is re-fetched from the tenant-scoped document store\nand its ownership verified before the citation is trusted: a caller\ncannot get a grounded answer that leans on a document belonging to a\ndifferent tenant just by forging a ``document_id`` in the request body.",
        "operationId": "rag_answer_v1_rag_answer_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "question",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Question"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/EvidenceCitation"
                },
                "title": "Citations"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Rag Answer V1 Rag Answer Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
