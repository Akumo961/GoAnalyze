{
  "openapi": "3.1.0",
  "info": {
    "title": "GoAnalyze Government Document Intelligence Platform",
    "description": "Government-grade AI document intelligence API with audit, ABAC, RAG citations, and environmental review.",
    "version": "2.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "description": "Liveness probe: the process is up and serving requests. Deliberately\ndoes not touch the database or any external dependency, so it stays\nhealthy (and orchestrators don't kill/restart the pod) during a\ntransient outage of something the app can recover from on its own.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Ready",
        "description": "Readiness probe: can this instance actually serve real traffic right\nnow? Checks the database connection specifically, since that's a hard\ndependency for nearly every route. Returns 503 (not 200) when it can't,\nwhich is what a load balancer/orchestrator should act on to stop\nrouting traffic here -- unlike /health, which intentionally does not\nreflect this.",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Metrics",
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
